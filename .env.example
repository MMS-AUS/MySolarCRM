# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Custom Domain / Subdomain configuration (optional)
# e.g., https://crm.yourcompany.com.au
VITE_APP_URL=""

# Firebase Client Configuration (optional override for custom domain hosting)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# ==============================================================================
# XERO OAUTH 2.0 INTEGRATION (Production Cloud Accounting)
# ==============================================================================
# XERO_CLIENT_ID: The unique identifier for your registered Xero App (developer.xero.com)
XERO_CLIENT_ID=""

# XERO_CLIENT_SECRET: The confidential secret key generated in Xero Developer Portal
XERO_CLIENT_SECRET=""

# XERO_REDIRECT_URI: Authorized redirect callback URL registered in your Xero App
# Local dev: http://localhost:3000/api/auth/xero/callback
# Production: https://<your-domain>/api/auth/xero/callback
XERO_REDIRECT_URI=""

# NEXT_PUBLIC_APP_URL / APP_URL: Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE CREDENTIAL STORAGE (xero_credentials table)
# ==============================================================================
# SUPABASE_URL: Project URL from your Supabase Dashboard Settings -> API
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: API Key for Supabase operations
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# ==============================================================================
# GMAIL OAUTH 2.0 & GOOGLE CLOUD PUB/SUB INTEGRATION (Continuous CRM Email Sync)
# ==============================================================================
# GMAIL_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console (APIs & Services -> Credentials)
GMAIL_CLIENT_ID=""

# GMAIL_CLIENT_SECRET: OAuth 2.0 Client Secret from Google Cloud Console
GMAIL_CLIENT_SECRET=""

# GMAIL_REDIRECT_URI: Authorized redirect URI configured in Google Cloud Console
# Local dev: http://localhost:3000/api/auth/gmail/callback
# Production: https://<your-domain>/api/auth/gmail/callback
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"

# GOOGLE_PUBSUB_TOPIC: Full topic name for Gmail push notifications
# e.g., projects/my-gcp-project-12345/topics/gmail-inbox-watch
GOOGLE_PUBSUB_TOPIC=""



